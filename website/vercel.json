{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist/client",
  "routes": [
    { "src": "/download/?", "dest": "/api/download.js" },
    { "src": "/(legal|privacy|terms)/?", "dest": "/$1/index.html" },
    { "handle": "filesystem" },
    { "src": "/.*", "dest": "/index.html" }
  ]
}
