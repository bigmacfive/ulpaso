{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ulpaso",
  "version": "0.5.2",
  "identifier": "app.ulpaso.editor",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; font-src 'self' data:; img-src 'self' asset: http://asset.localhost data: blob: https:; style-src 'self' 'unsafe-inline'; script-src 'self'",
      "devCsp": "default-src 'self' http://localhost:1420; connect-src 'self' ipc: http://ipc.localhost http://localhost:1420 ws://localhost:1420; font-src 'self' data:; img-src 'self' asset: http://asset.localhost data: blob: https:; style-src 'self' 'unsafe-inline'; script-src 'self' http://localhost:1420"
    },
    "windows": [
      {
        "label": "main",
        "title": "Ulpaso",
        "width": 1154,
        "height": 822,
        "minWidth": 760,
        "minHeight": 560,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 8,
          "y": 16
        },
        "shadow": false
      }
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk5QTcxRUY1RUY3QTZGNTcKUldSWGIzcnY5UjZubVlFVk1mREY3Vm45WWtQdlRIYzNlUFliQ1c5dTdiOU5xZFpPZXN1Q2hLZ2MK",
      "endpoints": [
        "https://github.com/bigmacfive/ulpaso/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "resources": {
      "resources/asr/THIRD_PARTY_NOTICES.md": "resources/asr/THIRD_PARTY_NOTICES.md",
      "resources/asr/asr_artifacts.py": "resources/asr/asr_artifacts.py",
      "resources/asr/asr_protocol.py": "resources/asr/asr_protocol.py",
      "resources/asr/asr_worker.py": "resources/asr/asr_worker.py",
      "resources/asr/bootstrap.sh": "resources/asr/bootstrap.sh",
      "resources/asr/requirements.lock": "resources/asr/requirements.lock",
      "resources/locales/en.lproj": "en.lproj",
      "resources/locales/ko.lproj": "ko.lproj",
      "resources/locales/ja.lproj": "ja.lproj"
    },
    "category": "Productivity",
    "shortDescription": "A quiet Markdown editor",
    "longDescription": "Ulpaso is a focused WYSIWYG Markdown editor for thoughtful writing.",
    "macOS": {
      "minimumSystemVersion": "15.0",
      "signingIdentity": "-",
      "entitlements": "Entitlements.plist",
      "infoPlist": "Info.plist",
      "dmg": {
        "background": "dmg/ulpaso-dmg-background.png",
        "windowSize": {
          "width": 660,
          "height": 400
        },
        "appPosition": {
          "x": 180,
          "y": 200
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 200
        }
      }
    }
  }
}
