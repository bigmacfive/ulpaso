/src-tauri/icons/android/
/src-tauri/icons/ios/
/src-tauri/icons/Square*.png
/src-tauri/icons/StoreLogo.png
/src-tauri/icons/icon.ico

# Retired local assets retained outside the published source set.
/src/assets/WantedSansVariable.woff2
/WANTED_SANS_LICENSE.txt
/src-tauri/resources/WANTED_SANS_LICENSE.txt

