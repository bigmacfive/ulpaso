# JavaScript
node_modules/
/dist/
/packages/*/dist/

# Local motion-graphics workspace and rendered video masters.
# The optimized README GIF in docs/assets remains tracked.
/packages/brand-video/

# Rust and generated Tauri state
/src-tauri/target/
/src-tauri/gen/

# The relocatable Python runtime is reproducibly assembled during packaging.
/src-tauri/resources/asr-runtime/

# Local design audits and third-party visual references are not release assets.
/design-audit-current/
/design-references/
/design-qa.md

